      "title": "Verify a license key for a product",
      "provider": "gumroad",
      "risk": "low",
      "mode": "read",
      "requires": [
        "gumroad"
      ],
      "preview": true,
      "receipt_required": true,
      "side_effects": "none",
      "input_schema": {
        "product_id": {
          "type": "string",
          "required": true
        },
        "license_key": {
          "type": "string",
          "required": true
        },
        "increment_uses_count": {
          "type": "boolean",
          "required": false
        }
      },
      "output_schema": {
        "valid": "boolean",
        "uses": "number",
        "purchase_email": "string"

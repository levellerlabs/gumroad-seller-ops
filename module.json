      "title": "Create an offer code (fixed or percent)",
      "provider": "gumroad",
      "risk": "medium",
      "mode": "write_requires_approval",
      "requires": [
        "gumroad"
      ],
      "preview": true,
      "receipt_required": true,
      "side_effects": "external",
      "input_schema": {
        "product_id": {
          "type": "string",
          "required": true
        },
        "name": {
          "type": "string",
          "required": true
        },
        "amount_off": {
          "type": "number",
          "required": true
        },
        "offer_type": {
          "type": "string",
          "required": false
        },
        "max_purchase_count": {
          "type": "number",
          "required": false
        }
      },
      "output_schema": {
        "offer_code_id": "string",
        "name": "string",
        "http_status": "number"
      }
    },
    {
      "id": "gumroad.list_offer_codes",
      "title": "List offer codes for a product",
      "provider": "gumroad",
      "risk": "low",
      "mode": "read",
      "requires": [

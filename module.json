{
  "id": "levellerco/gumroad-seller-ops",
  "name": "gumroad-seller-ops",
  "version": "1.0.2",
  "manifest_version": 1,
  "publisher_pubkey": "b8d07b5fa00f5e23089da5ac9e612cee94373fd0b7536f7af22d03b2a46279dd",
  "provider": "gumroad",
  "description": "Governed Gumroad seller operations. Ten commands covering the day-to-day seller loop: product catalogue reads, sales/revenue reporting, license verification, subscriber and audience-email pulls, offer-code create/list/delete, and price updates - all through the preview -> approve -> execute airlock. Auth = one Gumroad API token (Bearer). Built for digital-product sellers who want sales checks and discount management inside governed workflows instead of raw API calls.",
  "credential_spec": {
    "provider": "gumroad",
    "category": "Revenue",
    "name": "Gumroad (API token)",
    "required": [
      "access_token"
    ],
    "optional": [],
    "shape": "dict",
    "risk": "medium",
    "read_write": "write"
  },
  "allowed_destinations": [
    {
      "provider": "gumroad",
      "hosts": [
        "api.gumroad.com"
      ]
    }
  ],
  "requires": {
    "network": [
      "api.gumroad.com"
    ],
    "subprocess": false
  },
  "category": "Revenue",
  "commands": [
    {
      "id": "gumroad.list_products",
      "title": "List Gumroad products",
      "provider": "gumroad",
      "risk": "low",
      "mode": "read",
      "requires": [
        "gumroad"
      ],
      "preview": true,
      "receipt_required": true,
      "side_effects": "none",
      "input_schema": {
        "page": {
          "type": "number",
          "required": false
        },
        "per_page": {
          "type": "number",
          "required": false
        }
      },
      "output_schema": {
        "count": "number",
        "products": "array"
      }
    },
    {
      "id": "gumroad.get_product",
      "title": "Get one Gumroad product",
      "provider": "gumroad",
      "risk": "low",
      "mode": "read",
      "requires": [
        "gumroad"
      ],
      "preview": true,
      "receipt_required": true,
      "side_effects": "none",
      "input_schema": {
        "product_id": {
          "type": "string",
          "required": true
        }
      },
      "output_schema": {
        "product_id": "string",
        "name": "string",
        "price_cents": "number",
        "published": "boolean",
        "sales_count": "number"
      }
    },
    {
      "id": "gumroad.sales_summary",
      "title": "Sales and revenue summary",
      "provider": "gumroad",
      "risk": "low",
      "mode": "read",
      "requires": [
        "gumroad"
      ],
      "preview": true,
      "receipt_required": true,
      "side_effects": "none",
      "input_schema": {
        "after": {
          "type": "string",
          "required": false
        },
        "before": {
          "type": "string",
          "required": false
        },
        "product_id": {
          "type": "string",
          "required": false
        }
      },
      "output_schema": {
        "sales_count": "number",
        "gross_cents": "number",
        "net_cents": "number",
        "currency": "string"
      }
    },
    {
      "id": "gumroad.list_sales",
      "title": "List recent sales (detail rows)",
      "provider": "gumroad",
      "risk": "low",
      "mode": "read",
      "requires": [
        "gumroad"
      ],
      "preview": true,
      "receipt_required": true,
      "side_effects": "none",
      "input_schema": {
        "after": {
          "type": "string",
          "required": false
        },
        "before": {
          "type": "string",
          "required": false
        },
        "product_id": {
          "type": "string",
          "required": false
        },
        "limit": {
          "type": "number",
          "required": false
        }
      },
      "output_schema": {
        "sales_count": "number",
        "sales": "array"
      }
    },
    {

          "type": "string",
          "required": true
        }
      },
      "output_schema": {
        "subscribers_count": "number",
        "subscribers": "array"
      }
    },
    {
      "id": "gumroad.list_emails",
      "title": "List audience emails",
      "provider": "gumroad",
      "risk": "low",
      "mode": "read",
      "requires": [
        "gumroad"
      ],
      "preview": true,
      "receipt_required": true,
      "side_effects": "none",
      "input_schema": {},
      "output_schema": {
        "emails_count": "number",
        "emails": "array"
      }
    },
    {
